# Environment Configuration
APP_NAME=AI Chatbot
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=dev_secret_key_change_in_production_super_secure_random_string_32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database
DATABASE_URL=sqlite:///./ai_chatbot.db

# LLM Provider Configuration
# Supported providers: openai, gemini, mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
MAX_HISTORY_MESSAGES=10

# RAG & Embedding Configuration
# Supported embedding providers: openai, gemini, mock
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIRECTORY=./chroma_db
RAG_SIMILARITY_THRESHOLD=0.3
RAG_TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150

Run this project like 
python -m pip install -r requirements.txt
python -m uvicorn app.main:app --reload --port 8000